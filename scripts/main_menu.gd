extends Control
## Main menu with Play, Continue, Settings, Credits, and Exit (1.4).
## Play and Continue both open the save slot picker. Main listens for the
## slot the player picks.

signal new_game_requested(slot: int)
signal continue_requested(slot: int)

@onready var play_button: Button = $Menu/Play
@onready var continue_button: Button = $Menu/Continue
@onready var how_button: Button = $Menu/HowToPlay
@onready var how_panel: PanelContainer = $HowToPlayPanel
@onready var settings_button: Button = $Menu/Settings
@onready var credits_button: Button = $Menu/Credits
@onready var exit_button: Button = $Menu/Exit
@onready var settings_panel: PanelContainer = $SettingsPanel
@onready var slots_panel: Control = $SaveSlotsPanel
@onready var credits: PanelContainer = $Credits
@onready var credits_text: RichTextLabel = $Credits/Box/Text
@onready var credits_back: Button = $Credits/Box/Back


func _ready() -> void:
	if not can_process():
		return
	continue_button.disabled = not GameState.has_saved_run()
	play_button.pressed.connect(func(): _open_slots("new", play_button))
	continue_button.pressed.connect(func(): _open_slots("continue", continue_button))
	slots_panel.slot_chosen.connect(_on_slot_chosen)
	slots_panel.closed.connect(_on_slots_closed)
	settings_button.pressed.connect(func(): Sfx.play(self, "click"); settings_panel.open())
	settings_panel.visibility_changed.connect(func(): if not settings_panel.visible: settings_button.grab_focus())
	how_button.pressed.connect(how_panel.open)
	how_panel.visibility_changed.connect(func(): if not how_panel.visible: how_button.grab_focus())
	credits_button.pressed.connect(_show_credits)
	credits_back.pressed.connect(func(): credits.visible = false; credits_button.grab_focus())
	exit_button.pressed.connect(func(): get_tree().quit())
	settings_panel.visible = false
	slots_panel.visible = false
	how_panel.visible = false
	credits.visible = false
	play_button.grab_focus()


var _slots_opener: Button


func _open_slots(mode: String, opener: Button) -> void:
	_slots_opener = opener
	slots_panel.open(mode)


func _on_slots_closed() -> void:
	# A slot may have been deleted while the picker was open.
	continue_button.disabled = not GameState.has_saved_run()
	if _slots_opener and not _slots_opener.disabled:
		_slots_opener.grab_focus()
	else:
		play_button.grab_focus()


func _on_slot_chosen(slot: int, mode: String) -> void:
	if mode == "continue":
		continue_requested.emit(slot)
	else:
		new_game_requested.emit(slot)


func _show_credits() -> void:
	Sfx.play(self, "click")
	var t := "[font_size=24][b]Tindahan: Lola's Pamana[/b][/font_size]\nBen & Beni, BSCS IAC1, University of Baguio\n\n"
	t += "[b]Team[/b]\n"
	for member in [
		["Bencila, Adrian Marc C.", "Technical Writer and System Designer"],
		["Grueso, Angel Mae T.", "2D Lead Artist and Animator"],
		["Noefe, Judah Zoe Athaliah G.", "Narrative Designer and Sound Designer"],
		["Osting, Nadine Kyla G.", "Project Manager and Game Designer"],
		["Rivera, Benedict D.", "Front-End Developer and Tester"],
	]:
		t += "%s: %s\n" % member
	t += "\n[b]Assets[/b]\n"
	t += "Character and entity art: drawn by the team.\n"
	t += "Shop goods: generated by the team with Gemini.\n"
	t += "Store backgrounds: built from a Magnific Premium vector.\n"
	t += "Main menu art: based on Random Streets: Vigan, Philippines by tubik.arts.\n"
	t += "Sound effects and radio music: AI-assisted, created by the team with Python using tools/make_audio.py.\n\n"
	t += "[b]Godot Engine[/b]\nThis game uses Godot Engine, available under the following license:\n\n"
	t += Engine.get_license_text()
	credits_text.text = t
	credits.visible = true
	credits_back.grab_focus()
